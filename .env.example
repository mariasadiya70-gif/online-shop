# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/shophub

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-production

# bKash - use credentials supplied by your official bKash merchant account
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=http://localhost:5000/api/payments/bkash/callback

# Nagad - use credentials supplied by your official Nagad merchant account
NAGAD_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_MERCHANT_PUBLIC_KEY=
NAGAD_CALLBACK_URL=http://localhost:5000/api/payments/nagad/callback
